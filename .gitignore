# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and secrets
.env
.env.*
!.env.example

# Data: never commit raw or generated datasets
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
data/manifests/*
!data/**/.gitkeep

# Model and experiment artifacts
artifacts/*
!artifacts/**/.gitkeep
mlruns/
.prefect/

# Reports generated by execution
reports/resource_usage/*.json
!reports/resource_usage/.gitkeep

# Notebooks
.ipynb_checkpoints/

# macOS / IDE
.DS_Store
.idea/

# Docker / local database
postgres_data/
